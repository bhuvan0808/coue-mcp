{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coue-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // COUE never logs request bodies or analyzed source.
      "head_sampling_rate": 1
    }
  }
  // Note: "limits.cpu_ms" and "placement.mode" are paid-plan features.
  // COUE's analysis is short-lived enough not to need either; add them back
  // if this Worker is moved to a paid plan.
}
